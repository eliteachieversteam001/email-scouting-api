# ── Identity: the Elite Firebase project (the ONLY identity provider) ──
FIREBASE_PROJECT_ID=eliteachievers-b8782
# Server-side path to the Elite service-account JSON. Needs Firebase Auth (token
# verification/revocation) + Cloud Firestore read/write (Email Scouting data,
# read-only use of users/{uid} and platform data). Never commit it,
# never put it in a NEXT_PUBLIC_* variable. Leave empty to use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/email-scouting/firebase-service-account.json
# Reject tokens revoked by Firebase (password change / sign-out everywhere).
FIREBASE_CHECK_REVOKED=true
# Seconds a member's Elite status/admin/identity is cached (suspensions apply within this window).
PROFILE_CACHE_SECONDS=30

# ── CORS (comma-separated, exact origins) ──
ALLOWED_ORIGINS=https://scout.eliteachieversteam.com

# ── Verifier (MailClean settings) ──
FROM_EMAIL=verify@eliteachieversteam.com
SMTP_TIMEOUT=10
RETRY_COUNT=2
MAX_THREADS=30

# ── Limits ──
MAX_CLAIM_PER_USER_PER_DAY=3000
MAX_BULK_EMAILS=50000
MAX_UPLOAD_BYTES=20971520

# All application data lives in Firestore of this same project — no database URL needed.

# production | test (production refuses to start with Firebase emulator variables set)
APP_ENV=production
